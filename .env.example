# Enter real secrets privately in Render, never commit them.
OPENAI_API_KEY=
COMIC_BOOTSTRAP_USERNAME=damico
COMIC_BOOTSTRAP_PASSWORD=
COMIC_DATA_DIR=/var/data/comicai
COMIC_TEXT_MODEL=gpt-4.1-mini
COMIC_IMAGE_MODEL=gpt-image-1
# Render's assigned HTTPS URL is detected automatically.
# COMIC_PUBLIC_URL=https://your-actual-server.onrender.com
# .env is not loaded automatically outside Docker Compose.

# Only for the optional Docker/VPS Compose deployment:
# COMIC_DOMAIN=your-deployed-api-host
